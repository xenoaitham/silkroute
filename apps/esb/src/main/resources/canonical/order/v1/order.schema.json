{
  "$id": "urn:maple:canonical:order:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maple Retail Group (fictional) canonical order v1 — ESB inbound request shape",
  "description": "ESB-owned canonical model (constraint C6: the ERP contracts are frozen, all impedance mismatch lives here). Money never appears in the inbound request; totals are priced by the ERP in the store's region currency (C5: integer minor units). The audit block mirrors the frozen LegacyAuditType (urn:maple:erp:common:v1) so correlation ids are preserved end-to-end.",
  "type": "object",
  "additionalProperties": false,
  "required": ["externalOrderRef", "sourceSystem", "storeId", "channel", "lines", "audit"],
  "properties": {
    "externalOrderRef": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sourceSystem": { "type": "string", "minLength": 1, "maxLength": 64 },
    "storeId": { "type": "string", "pattern": "^ST-(CA|SG|CN)-[0-9]{2}$" },
    "channel": { "enum": ["WEB_STORE", "POS", "PHONE", "EDI"] },
    "customerRef": { "type": "string", "maxLength": 64 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skuId", "quantity"],
        "properties": {
          "skuId": { "type": "string", "pattern": "^SKU-[0-9]{4}$" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 999 }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSystem", "receivedAt", "correlationId"],
      "properties": {
        "sourceSystem": { "type": "string", "minLength": 1, "maxLength": 64 },
        "receivedAt": { "type": "string", "format": "date-time" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
