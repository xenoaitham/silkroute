<?xml version="1.0" encoding="UTF-8"?>
<!--
  SILKROUTE Phase 2 — Maple Retail Group (fictional) integration hub (apps/esb).

  The ESB mediates modern REST/JSON to the FROZEN SOAP ERP estate (constraint C6):
  wsdl2java reads the WSDLs/XSDs at ../legacy-erp (read-only, single source of truth,
  git tag contract-freeze-erp-v1) and reuses the same JAXB binding files, so ALL
  impedance mismatch lives here (canonical model urn:maple:canonical:order:v1 +
  XSLT legs under src/main/resources/xslt).

  Money discipline (C5): integer minor units + CAD/SGD/CNY code everywhere, never
  floats. PII residency hook (C1): PiiMaskingPolicy masks CN-region customerRef
  before any egress to shared Kafka topics.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>com.mapleretail.silkroute</groupId>
  <artifactId>esb</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>esb</name>
  <description>Maple Retail (fictional) Camel ESB: REST facade, saga, XSLT mediation, masking egress</description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <camel.version>4.10.3</camel.version>
    <cxf.version>4.0.5</cxf.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>${camel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ==================== Camel (integration backbone) ==================== -->
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-spring-boot-starter</artifactId>
    </dependency>
    <!-- REST facade: platform-http serves POST /api/v1/orders on loopback only. -->
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-platform-http-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-direct-starter</artifactId>
    </dependency>
    <!-- networknt JSON Schema (draft 2020-12) validation of inbound canonical JSON. -->
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-json-validator-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-kafka-starter</artifactId>
    </dependency>
    <!-- Circuit breaker wrapping the ERP gateway. -->
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-resilience4j-starter</artifactId>
    </dependency>
    <!-- XSLT legs (JDK Transformer engine; stylesheets cached as Templates). -->
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-xslt-starter</artifactId>
    </dependency>

    <!-- ==================== SOAP client to the FROZEN ERP ==================== -->
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-frontend-jaxws</artifactId>
      <version>${cxf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-transports-http</artifactId>
      <version>${cxf.version}</version>
    </dependency>
    <!-- WS-Security UsernameToken (PasswordText) outbound interceptor. -->
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-ws-security</artifactId>
      <version>${cxf.version}</version>
    </dependency>

    <!-- ==================== idempotent consumer (Redis SETNX) ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- JSON (canonical model + responses). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- wsdl2java: READ-ONLY generation from the FROZEN contracts (C6).
           Same WSDLs and JAXB binding files as the ERP build, referenced by path.
           Never edit anything under ../legacy-erp — freeze tag contract-freeze-erp-v1. -->
      <plugin>
        <groupId>org.apache.cxf</groupId>
        <artifactId>cxf-codegen-plugin</artifactId>
        <version>${cxf.version}</version>
        <executions>
          <execution>
            <id>generate-erp-contract-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>wsdl2java</goal>
            </goals>
            <configuration>
              <sourceRoot>${project.build.directory}/generated-sources/wsdl2java</sourceRoot>
              <wsdlOptions>
                <wsdlOption>
                  <wsdl>${project.basedir}/../legacy-erp/src/main/resources/wsdl/OrderService-v1.wsdl</wsdl>
                  <bindingFiles>
                    <bindingFile>${project.basedir}/../legacy-erp/src/main/jaxb/orders-contract-bindings.xml</bindingFile>
                  </bindingFiles>
                </wsdlOption>
                <wsdlOption>
                  <wsdl>${project.basedir}/../legacy-erp/src/main/resources/wsdl/InventoryService-v1.wsdl</wsdl>
                  <bindingFiles>
                    <bindingFile>${project.basedir}/../legacy-erp/src/main/jaxb/inventory-contract-bindings.xml</bindingFile>
                  </bindingFiles>
                </wsdlOption>
                <wsdlOption>
                  <wsdl>${project.basedir}/../legacy-erp/src/main/resources/wsdl/PricingService-v1.wsdl</wsdl>
                  <bindingFiles>
                    <bindingFile>${project.basedir}/../legacy-erp/src/main/jaxb/pricing-contract-bindings.xml</bindingFile>
                  </bindingFiles>
                </wsdlOption>
              </wsdlOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
